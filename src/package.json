{
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "properties": {
        "%name%.codes": {
          "default": [],
          "description": "%configDescription%",
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "title": "%configTitle%",
      "type": "object"
    },
    "typescriptServerPlugins": [
      {
        "enableForWorkspaceTypeScriptVersions": true,
        "name": "%name%"
      }
    ]
  },
  "description": "%description%",
  "displayName": "%displayName%",
  "engines": {
    "vscode": "^1.56.0"
  },
  "main": "./extension.js",
  "name": "%name%",
  "publisher": "ericchase",
  "version": "1.0.0"
}