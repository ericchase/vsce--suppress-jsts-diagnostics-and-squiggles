{
  "activationEvents": [
    "onStartupFinished"
  ],
  "author": {
    "name": "ericchase",
    "url": "https://github.com/ericchase"
  },
  "bugs": {
    "url": "https://github.com/ericchase/vsce-suppress-jsts-diagnostics-and-squiggles/issues"
  },
  "contributes": {
    "configuration": {
      "properties": {
        "suppress-jsts-diagnostics-and-squiggles.codes": {
          "default": [],
          "description": "Array of JS/TS diagnostic codes to suppress.",
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "title": "Suppress User-Defined JS/TS Diagnostics And Squiggles",
      "type": "object"
    },
    "typescriptServerPlugins": [
      {
        "enableForWorkspaceTypeScriptVersions": true,
        "name": "suppress-jsts-diagnostics-and-squiggles"
      }
    ]
  },
  "description": "%description%",
  "displayName": "%displayName%",
  "engines": {
    "vscode": "^1.100.0"
  },
  "homepage": "https://github.com/ericchase/vsce-suppress-jsts-diagnostics-and-squiggles",
  "license": "Apache-2.0",
  "main": "./extension.js",
  "name": "suppress-jsts-diagnostics-and-squiggles",
  "publisher": "ericchase",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericchase/vsce-suppress-jsts-diagnostics-and-squiggles.git"
  },
  "version": "1.0.2"
}
